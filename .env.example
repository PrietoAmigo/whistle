# Copy to .env and fill in what you use.

# --profile https: the address the phone opens, e.g. the server's WireGuard IP.
WHISTLE_HOST=10.8.0.1

# Listen only on this address, e.g. the server's WireGuard IP, so only the VPN
# can reach Whistle. Docker's published ports bypass ufw/firewalld rules.
# BIND_ADDRESS=10.8.0.1

# --profile tunnel: the token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
